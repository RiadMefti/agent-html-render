{
  "name": "agent-html-render",
  "version": "0.3.1",
  "description": "Review agent-written HTML locally and send element-level feedback to the agent.",
  "type": "module",
  "bin": {
    "agent-html-render": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:ui && npm run build:bridge",
    "build:node": "tsc -p tsconfig.node.json",
    "build:ui": "vite build --config vite.config.ts",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev:cli": "tsx src/node/cli.ts",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run smoke:agents:strict",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "smoke:agents:strict": "node scripts/smoke-agents.mjs --strict",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "agents",
    "annotation",
    "html",
    "review",
    "visual-feedback",
    "html-artifacts",
    "local-first",
    "human-in-the-loop",
    "developer-tools",
    "codex",
    "claude-code",
    "opencode"
  ],
  "author": "Riad Mefti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiadMefti/agent-html-render.git"
  },
  "bugs": {
    "url": "https://github.com/RiadMefti/agent-html-render/issues"
  },
  "homepage": "https://github.com/RiadMefti/agent-html-render#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "open": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
